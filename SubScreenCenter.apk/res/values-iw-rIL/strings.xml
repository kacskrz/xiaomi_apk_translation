    <string name="ms_guide_tip_assistant">יש להחליק למטה מהחלק העליון לפתיחת העוזר. יש להחליק בקו אנכי למעבר בין השירותים. יש להחליק למעלה מהתחתית לסגירה.</string>
    <string name="ms_guide_tip_assistant_new">יש להחליק למטה מהחלק העליון לפתיחת השירותים. יש להחליק למעלה או למטה למעבר בין השירותים, ויש להחליק למעלה מהתחתית לסגירה.</string>
    <string name="ms_guide_tip_camera">יש להחליק ימינה לפתיחת המצלמה. יש להחליק שמאלה מהקצה כדי לחזור.</string>
    <string name="ms_guide_tip_dial">יש ללחוץ לחיצה ממושכת לעריכה. יש להחליק בקו אופקי להחלפת השעון. יש להקיש לאישור.</string>
    <string name="ms_guide_tip_wallpaper">יש ללחוץ לחיצה ממושכת לעריכה. יש להחליק שמאלה או ימינה להחלפת הטפט. יש להקיש לאישור.</string>
