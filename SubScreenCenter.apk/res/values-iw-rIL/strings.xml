    <string name="guide_on_off_screen_comment">כדי לשמור על חוויית גיימינג טובה, בזמן שימוש במשחקים מסוימים שמוצגים בתצוגה הקדמית לא ניתן להעיר את התצוגה האחורית על-ידי הקשה כפולה</string>
    <string name="guide_on_off_screen_summary">יש להקיש פעמיים כדי להעיר את התצוגה האחורית, ולאחר מכן שוב להקיש פעמיים כדי לכבות אותה.</string>
    <string name="guide_on_off_screen_title">הפעלה וכיבוי של המסך</string>
