    <string name="ms_guide_tip_assistant">Rrëshqitni poshtë nga lart për të hapur Asistentin. Rrëshqitni vertikalisht për të ndërruar shërbimet. Rrëshqitni lart nga poshtë për ta mbyllur.</string>
    <string name="ms_guide_tip_assistant_new">"Rrëshqitni poshtë nga lart për të hapur shërbimet, rrëshqitni lart ose poshtë për të kaluar ndërmjet tyre dhe rrëshqitni lart nga poshtë për t'i mbyllur."</string>
    <string name="ms_guide_tip_camera">"Rrëshqit djathtas për të hapur kamerën. Rrëshqit majtas nga skaji për t'u kthyer prapa."</string>
    <string name="ms_guide_tip_dial">Shtypni dhe mbani shtypur për të modifikuar. Rrëshqitni horizontalisht për të ndërruar orët. Klikoni për të konfirmuar.</string>
    <string name="ms_guide_tip_wallpaper">Shtypni dhe mbani shtypur për të modifikuar, rrëshqitni majtas ose djathtas për të ndryshuar sfondin, klikoni për të konfirmuar.</string>
