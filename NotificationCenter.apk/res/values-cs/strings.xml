    <string name="notifications_app_list_entry_description">Settings for managing whether each app can send notifications, covering per-app control, sorting by time received, and access to each app notification settings page.</string>
    <string name="notifications_app_notification_settings_description">Settings for a specific app notifications, covering whether it can send notifications, Xiaomi HyperIsland, badges, floating and lock screen notifications, sound, vibration, and permanent notifications.</string>
    <string name="notifications_badges_description">Settings page for notification badges, where users can manage on a per-app basis whether notification badges are allowed.</string>
    <string name="notifications_badges_hint_text">App notification badge permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_badges_metadata_hint_text">App notification badge switch. Requires app notification permission to be enabled before modification.</string>
    <string name="notifications_floating_description">Settings for floating notifications, covering the Hide temporarily rule and per-app control over whether floating notifications are allowed.</string>
    <string name="notifications_floating_hint_text">App floating notification permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_floating_metadata_hint_text">App floating notification switch. Requires app notification permission to be enabled before modification.</string>
    <string name="notifications_lock_screen_hint_text">App lock screen notification permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_lock_screen_metadata_hint_text">App lock screen notification switch. Requires app notification permission to be enabled before modification.</string>
    <string name="notifications_lockscreen_description">Settings for lock screen notifications, covering the display style (List, Stack, or Number), format, and per-app control over whether lock screen notifications are allowed.</string>
    <string name="notifications_permanent_hint_text">App permanent notification permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_permanent_metadata_hint_text">App persistent notification switch. Requires app notification permission to be enabled before modification.</string>
    <string name="notifications_show_notification_hint_text">App notification permission switch. JSON object where keys are app package names and values are true (allow notifications) or false (block notifications).</string>
    <string name="notifications_show_notification_metadata_hint_text">App notification permission switch. Not writable on international builds due to privacy policy restrictions; writable on domestic builds.Only one app can be modified at a time.</string>
    <string name="notifications_sound_hint_text">App notification sound permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_sound_metadata_hint_text">App notification sound switch. Requires app notification permission to be enabled before modification.</string>
    <string name="notifications_spotlight_hint_text">App Xiaomi HyperIsland permission switch. JSON object where keys are app package names and values are true (enabled), false (disabled), or not_supported (does not support Xiaomi HyperIsland). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_spotlight_metadata_hint_text">App notification Xiaomi HyperIsland switch. Requires app notification permission to be enabled before modification.</string>
    <string name="notifications_status_bar_description">Global settings for notifications, status bar, and control center, covering Xiaomi HyperIsland, lock screen and floating notifications, badges, app notifications, carrier display, and battery indicator.</string>
    <string name="notifications_vibration_hint_text">App notification vibration permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_vibration_metadata_hint_text">App notification vibration switch. Requires app notification permission to be enabled before modification.</string>
