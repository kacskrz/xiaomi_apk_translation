    <string name="ai_dialog_text">סיכום התראות AI מספק סיכומים חכמים של המידע העיקרי מהתראות. Xiaomi צריכה לקבל גישה לתוכן ההתראות ולעבד אותו כדי לספק את המאפיין הזה, אך Xiaomi לא תאחסן את המידע הזה.</string>
    <string name="ai_dialog_title">לאפשר גישה להתראות</string>
    <string name="ai_enhanced_summary">קבלו סיכומים חכמים של התראות והודעות</string>
    <string name="ai_enhanced_summary_pad">קבלו סיכומים עם המידע החשוב ביותר בהתראות</string>
    <string name="ai_enhanced_title">תקציר AI</string>
    <string name="ai_notification_illustrate_text">"תדרוך AI דולה את המידע החשוב ביותר בהתראות ובהודעות ומציג אותו ברשימת התצוגה המקדימה.
חברת Xiaomi תעבד את תוכן ההתראות וההודעות (כולל כל הנתונים הפרטיים שהן מכילות), אך לא תאחסן את הנתונים הללו."</string>
    <string name="ai_notification_illustrate_text_pad">"קבלו סיכומים חכמים עבור התראות שמוצגות ברשימת התצוגה המקדימה, כדי לעיין בהן בקלות.
תוכן הסיכומים, כולל מידע פרטי שהם מכילים, יעובד על-ידי Xiaomi, אך אנו לא נאחסן את הנתונים האלה."</string>
    <string name="ai_notification_summary">סיכום התראות AI מספק סיכומים חכמים של המידע העיקרי מהתראות. מאפיין זה מביא לעלייה קלה בצריכת החשמל.</string>
