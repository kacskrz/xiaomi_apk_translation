    <string name="ai_enhanced_summary_pad">অধিসূচনাৰ সৰ্বাধিক গুৰুত্বপূৰ্ণ তথ্যৰ সাৰাংশসমূহ লাভ কৰক</string>
    <string name="ai_enhanced_title">AI ব্ৰিফিং</string>
    <string name="ai_notification_illustrate_text">"AI ব্ৰিফিঙে অধিসূচনা আৰু বাৰ্তাসমূহত আটাইতকৈ গুৰুত্বপূৰ্ণ তথ্য বাছনি কৰে আৰু সেইসমূহ পূৰ্বলোকন সূচীত প্ৰদৰ্শন কৰে।
Xiaomi এ অধিসূচনা আৰু বাৰ্তাৰ সমল প্ৰক্ৰিয়া কৰিব (তাত থকা যিকোনো ব্যক্তিগত ডাটা সহ), কিন্তু আমি এই ডাটা সঞ্চয় নকৰো।"</string>
    <string name="ai_notification_illustrate_text_pad">"সহজ সন্দৰ্ভৰ বাবে পূৰ্বলোকন সূচীত প্ৰদৰ্শিত অধিসূচনাসমূহৰ বাবে স্মাৰ্ট সাৰাংশ লাভ কৰক।
সাৰাংশ সমল, তাত থকা যিকোনো ব্যক্তিগত তথ্যকে ধৰি, Xiaomi-ৰ দ্বাৰা সংসাধন কৰা হ'ব, কিন্তু আমি এই ডাটা সঞ্চয় নকৰো।"</string>
    <string name="ai_notification_summary">AI অধিসূচনা সাৰাংশই অধিসূচনাৰ পৰা মূল তথ্যৰ স্মাৰ্ট সাৰাংশ প্ৰদান কৰে। এই বৈশিষ্ট্যই পাৱাৰ খৰচ সামান্য বৃদ্ধি কৰিব।</string>
