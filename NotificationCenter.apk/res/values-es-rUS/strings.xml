    <string name="notifications_app_list_entry_description">Settings for managing whether each app can send notifications, covering per-app control, sorting by time received, and access to each app notification settings page.</string>
    <string name="notifications_app_notification_settings_description">Settings for a specific app notifications, covering whether it can send notifications, Xiaomi HyperIsland, badges, floating and lock screen notifications, sound, vibration, and permanent notifications.</string>
    <string name="notifications_badges_description">Settings page for notification badges, where users can manage on a per-app basis whether notification badges are allowed.</string>
    <string name="notifications_badges_hint_text">App notification badge permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
    <string name="notifications_badges_metadata_hint_text">App notification badge switch. Requires app notification permission to be enabled before modification.</string>
    <string name="notifications_floating_description">Settings for floating notifications, covering the Hide temporarily rule and per-app control over whether floating notifications are allowed.</string>
    <string name="notifications_floating_hint_text">App floating notification permission switch. JSON object where keys are app package names and values are true (enabled) or false (disabled). This permission depends on app notification permission being enabled.</string>
