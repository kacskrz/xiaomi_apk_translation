    <string name="ai_enhanced_title">Resumir con IA</string>
    <string name="ai_notification_illustrate_text">"Resumir con IA selecciona la información más importante en las notificaciones y mensajes y los muestra en la lista de vista previa.
Xiaomi procesará el contenido de las notificaciones y mensajes (incluidos los datos privados que contienen), pero no almacenaremos estos datos."</string>
    <string name="ai_notification_illustrate_text_pad">"Obtenga resúmenes inteligentes de las notificaciones que se muestran en la lista de vista previa para una fácil referencia.
El contenido del resumen, incluida cualquier información privada que contenga, será procesado por Xiaomi, pero no almacenaremos estos datos."</string>
    <string name="ai_notification_summary">Resumen de notificaciones con IA ofrece resúmenes inteligentes de la información clave de las notificaciones. Esta función aumentará ligeramente el consumo de energía.</string>
