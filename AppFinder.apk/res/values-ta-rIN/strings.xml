    <string name="user_guide_welcome_privacy_collect_word">உங்கள் முக்கிய சொற்களைச் சேகரித்து அவற்றின் பதிவை வைத்திருக்கலாம்</string>
    <string name="user_guide_welcome_privacy_collect_word_1">தொடர்புடைய, துல்லியமான தேடல் முடிவுகளை வழங்க, தேடல் சொற்களின் சேகரிப்பை அனுமதிக்கவும்</string>
    <string name="user_guide_welcome_privacy_message">தொடர்வதற்கு முன்பு எங்கள் &lt;font color=\"#0a84ff\">&lt;a href=\"%1$s\" style=\"color:#0a84ff;\">தனியுரிமைக் கொள்கை&lt;/a>&lt;/font> மற்றும் &lt;font color=\"#0a84ff\">&lt;a href=\"%2$s\" style=\"color:#0a84ff;\">பயனர் ஒப்பந்தத்தைப்&lt;/a>&lt;/font> படித்து ஏற்றுக்கொள்ளவும்.</string>
    <string name="user_guide_welcome_privacy_message_1">நீங்கள் குறிப்பிட்ட பொருத்தமான அம்சத்தைப் பயன்படுத்தும் போது மட்டுமே உங்கள் தனிப்பட்ட தகவலைச் செயலாக்குவோம். நீங்கள் தொடர்வதற்கு முன் எங்கள் &lt;font color=\"#0a84ff\">&lt;a href=\"%1$s\" style=\"color:#0a84ff;\">தனியுரிமைக் கொள்கை&lt;/a>&lt;/font> மற்றும் &lt;font color=\"#0a84ff\">&lt;a href=\"%2$s\" style=\"color:#0a84ff;\">பயனர் ஒப்பந்தம்&lt;/a>&lt;/font> ஆகியவற்றைப் படித்து ஏற்கவும். எந்த நேரத்திலும் இந்தச் சேவையைப் பயன்படுத்துவதை நிறுத்த, &lt;font color=\"#0a84ff\">&lt;u>இங்கே&lt;/u>&lt;/font> தட்டவும்.</string>
    <string name="user_guide_welcome_privacy_message_title">மேற்கண்ட சேவைகளை வழங்க, இந்தச் செயலிக்கு பின்வரும் அனுமதிகள் தேவை:</string>
    <string name="user_guide_welcome_privacy_message_title_1">செயலிகள், படங்கள், கோப்புகள், செய்திகள், தொடர்புகள் மற்றும் பலவற்றைத் தேடுங்கள்</string>
